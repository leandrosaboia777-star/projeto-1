{
  "name": "saboia-cleaning",
  "version": "1.0.0",
  "private": true,
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts tests/*.test.cjs",
    "build:web": "expo export --platform web",
    "seed": "node --env-file-if-exists=.env --import tsx scripts/seed.ts",
    "test:db": "bash scripts/test-database.sh",
    "test:browser": "playwright test && playwright test --config playwright.auth.config.ts",
    "check:edge": "deno check --config supabase/functions/deno.json supabase/functions/assistant/index.ts supabase/functions/private-access/index.ts supabase/functions/confirm-proposal/index.ts supabase/functions/request-reminders/index.ts supabase/functions/translate-content/index.ts",
    "format": "prettier --write App.tsx app.config.ts src tests scripts/*.ts supabase/functions *.json *.ts",
    "android": "expo run:android",
    "test:edge": "deno test --allow-env=ACCESS_ENCRYPTION_KEY --config supabase/functions/deno.json supabase/functions/_shared/encryption_test.ts",
    "check:codegen": "node scripts/check-codegen.cjs",
    "check:ios-scenes": "node scripts/check-ios-scene-lifecycle.cjs"
  },
  "dependencies": {
    "@bacons/apple-targets": "^5.0.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "^2.57.0",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "expo": "~58.0.23",
    "expo-constants": "~58.0.15",
    "expo-dev-client": "~58.0.18",
    "expo-file-system": "~58.0.13",
    "expo-font": "~58.0.11",
    "expo-image-picker": "~58.0.10",
    "expo-linking": "~58.0.16",
    "expo-notifications": "~58.1.8",
    "expo-secure-store": "~58.0.2",
    "expo-speech": "~58.0.3",
    "expo-speech-recognition": "~58.0.1",
    "expo-splash-screen": "~58.0.13",
    "expo-status-bar": "~58.0.4",
    "lucide-react-native": "^0.577.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-svg": "15.16.0",
    "react-native-url-polyfill": "^2.0.0",
    "react-native-web": "~0.21.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/node": "^22.0.0",
    "@types/react": "~19.3.0",
    "deno": "^2.9.6",
    "prettier": "^3.9.10",
    "tsx": "^4.20.0",
    "typescript": "~5.9.2"
  },
  "overrides": {
    "postcss": "^8.5.32",
    "image-size": "^2.0.4",
    "@xmldom/xmldom": "^0.8.15",
    "uuid": "^11.1.1",
    "minimatch": "^11.0.5",
    "glob@7": {
      "minimatch": "^3.1.2"
    },
    "glob@10": "^14.0.4"
  }
}
