{
  "name": "saboia-cleaning",
  "version": "1.0.0",
  "private": true,
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "build:web": "expo export --platform web",
    "seed": "node --env-file-if-exists=.env --import tsx scripts/seed.ts",
    "test:db": "bash scripts/test-database.sh",
    "test:browser": "playwright test && playwright test --config playwright.auth.config.ts",
    "check:edge": "deno check --config supabase/functions/deno.json supabase/functions/assistant/index.ts supabase/functions/private-access/index.ts supabase/functions/confirm-proposal/index.ts",
    "format": "prettier --write App.tsx app.config.ts src tests scripts/*.ts supabase/functions *.json *.ts",
    "android": "expo run:android",
    "test:edge": "deno test --allow-env=ACCESS_ENCRYPTION_KEY --config supabase/functions/deno.json supabase/functions/_shared/encryption_test.ts"
  },
  "dependencies": {
    "@bacons/apple-targets": "^5.0.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "^2.57.0",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "expo": "~54.0.0",
    "expo-constants": "~18.0.14",
    "expo-dev-client": "~6.0.21",
    "expo-file-system": "~19.0.24",
    "expo-font": "~14.0.12",
    "expo-image-picker": "~17.0.11",
    "expo-linking": "~8.0.12",
    "expo-notifications": "~0.32.17",
    "expo-secure-store": "~15.0.8",
    "expo-speech": "~14.0.8",
    "expo-speech-recognition": "~3.1.3",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "lucide-react-native": "^0.577.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-svg": "15.12.1",
    "react-native-url-polyfill": "^2.0.0",
    "react-native-web": "^0.21.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/node": "^22.0.0",
    "@types/react": "~19.1.10",
    "deno": "^2.9.6",
    "prettier": "^3.9.10",
    "tsx": "^4.20.0",
    "typescript": "~5.9.2"
  },
  "overrides": {
    "postcss": "^8.5.32",
    "image-size": "^2.0.4",
    "@xmldom/xmldom": "^0.8.15",
    "uuid": "^11.1.1",
    "minimatch": "^11.0.4"
  }
}
